# Copy this file to .env.local and fill in real values.
# This URL is used server-side only — it is NOT exposed to the browser.

APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# --- Public settings (these ARE sent to the browser) -------------------------
# Leave any of these empty to hide that feature.

# Your live domain — used for link previews and Google product data.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Contact details (footer + floating WhatsApp button)
NEXT_PUBLIC_CONTACT_PHONE=
# WhatsApp defaults to the number in app/site.js; set this only to override it.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_MESSENGER_URL=

# Tracking: Facebook Pixel ID (digits) and Google Analytics 4 ID (G-XXXXXXXXXX)
NEXT_PUBLIC_FB_PIXEL_ID=
NEXT_PUBLIC_GA_ID=
